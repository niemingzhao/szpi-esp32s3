# ESP-IDF 工程最小配置

# 工程基础
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# 编译器
# 屏蔽 GCC 14、15 新增的警告；GCC 14 起默认按错误处理的诊断由顶层 CMakeLists.txt 对托管组件降级
CONFIG_COMPILER_DISABLE_GCC14_WARNINGS=y
CONFIG_COMPILER_DISABLE_GCC15_WARNINGS=y

# CPU 与缓存
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# 内存（PSRAM）
# 通用 malloc 优先 PSRAM（0 = 全部优先外部 RAM）；内部 RAM 留给 BLE 控制器 / 主机队列、
# 音频 I2S DMA、LVGL 绘制缓冲、各服务任务与队列。
# RESERVE_INTERNAL 给这些只能用内部内存的请求留一块（大块 DMA 缓冲在开机早期就分完）。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# 允许把任务栈放到 PSRAM（xTaskCreatePinnedToCoreWithCaps）：脚本任务 8 KB 的栈放 PSRAM，
# 把内部 DRAM 让给相机 DVP（要 7.6 KB 连续内部 DMA）等只能用内部内存的请求
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_FREERTOS_SUPPORT_STATIC_ALLOCATION=y

# 存储：TF 卡（FATFS）非 ASCII 长文件名，三项必须一起保留
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_CODEPAGE_936=y
CONFIG_FATFS_API_ENCODING_UTF_8=y

# 存储：内置 Flash（SPIFFS），对象名上限 128 字节；改后首次挂载会重新格式化
CONFIG_SPIFFS_OBJ_NAME_LEN=128

# 网络：Wi-Fi 静态收发缓冲每块约 1.6 KB 且只能用内部 RAM，8/8 足够
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
# 配网热点与 SmartConfig 的 APSTA 依赖 SoftAP
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# 网络：HTTPS 客户端（天气等）挂内置证书 bundle 才能通过校验，bundle 占一点 Flash
# mbedTLS 动态分配改走 PSRAM：TLS 握手要在内部 RAM 拿十几 KB，而 Wi-Fi + BLE + LVGL
# 起来后内部余量不够，会以 mbedtls_ssl_setup 失败告终
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# 蓝牙：主机用 Bluedroid（不用 NimBLE），只用 BLE 4.2
# BLE 4.2 与 5.0 两行必须一起写：5.0 的扩展广播会明显增加控制器内存
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
# CONFIG_BT_NIMBLE_ENABLED is not set
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
# CONFIG_BT_BLE_50_FEATURES_SUPPORTED is not set

# 蓝牙：控制器初始化要一块 30 KB 连续内部内存，主机侧动态数据优先放 PSRAM
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_BT_ACL_CONNECTIONS=2
# 控制器活动实例数（ble_max_act）同时决定控制器"环境内存池"大小，保持 IDF 默认 6，不要下调
CONFIG_BT_CTRL_BLE_MAX_ACT=6

# 蓝牙：不用 DTM（直接测试模式），主机与控制器两侧都关掉
# CONFIG_BT_CTRL_DTM_ENABLE is not set
# CONFIG_BT_BLE_42_DTM_TEST_EN is not set

# 显示（LVGL 9）：RGB565；内存分配走 C 库，即 IDF 堆；内嵌字体；启用图片解码
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_LODEPNG=y
CONFIG_LV_USE_GIF=y
CONFIG_LV_USE_BMP=y
CONFIG_LV_USE_TJPGD=y
# LVGL 图片缓存：整幅解码后的图按 ARGB8888（4 字节/像素）缓存，命中就不用重解，
# 开小了大图每帧重解会卡；4 MB 够放一张 1024×768（3 MB），PSRAM 按需分配。
# 表头缓存让 BMP / JPEG 这类逐行解码格式重绘时不必重开文件、重找解码器。
CONFIG_LV_CACHE_DEF_SIZE=4194304
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=16

# 摄像头：本板只有 GC0308 / GC2145，其余传感器驱动全部关闭
CONFIG_GC0308_SUPPORT=y
CONFIG_GC2145_SUPPORT=y
# CONFIG_OV7670_SUPPORT is not set
# CONFIG_OV7725_SUPPORT is not set
# CONFIG_OV2640_SUPPORT is not set
# CONFIG_OV3640_SUPPORT is not set
# CONFIG_OV3660_SUPPORT is not set
# CONFIG_OV5640_SUPPORT is not set
# CONFIG_NT99141_SUPPORT is not set
# CONFIG_GC032A_SUPPORT is not set
# CONFIG_BF3005_SUPPORT is not set
# CONFIG_BF20A6_SUPPORT is not set
# CONFIG_SC030IOT_SUPPORT is not set
# CONFIG_HM1055_SUPPORT is not set
# CONFIG_HM0360_SUPPORT is not set
# CONFIG_MEGA_CCM_SUPPORT is not set
# SCCB 端口这项已用不到：drv_camera.c 里 pin_sccb_sda = -1，让 esp32-camera 复用 I2C0
# （触摸 / IMU / PCA9557 那条），不再自建 I2C1 去抢 GPIO1/2
CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW=y
CONFIG_SCCB_HARDWARE_I2C_PORT1=y
# DMA 缓冲上限：整块 DMA 缓冲 = 2 × 半缓冲，且必须落在内部 RAM 的连续块里。
# 默认 32768 时 QVGA RGB565 要 30720 字节，而 BLE + Wi-Fi 起来后内部最大连续块
# 只有 15360 —— 直接 malloc 失败、相机打不开。降到 8192 后整块只要 7680 字节。
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=8192

# 调试与监控：性能监控 App 要算任务 CPU 占用（uxTaskGetSystemState）
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# 看门狗超时 5 s（启动完成后才打开超时自动重启）
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
