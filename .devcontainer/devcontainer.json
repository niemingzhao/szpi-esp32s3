{
    "name": "SZPI-OS (ESP-IDF v6.1)",
    "image": "espressif/idf:v6.1",
    "workspaceMount": "source=${localWorkspaceFolder},target=/project,type=bind",
    "workspaceFolder": "/project",
    "postCreateCommand": "python -m pip install --no-cache-dir --disable-pip-version-check pillow pre-commit",
    "containerEnv": {
        "IDF_CCACHE_ENABLE": "1"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd"
            ]
        }
    },
    "remoteUser": "root"
}
